{
	"appId": "de.schmoppo.cleanly",
	"appName": "cleanly",
	"server": {
		"hostname": "deeplink.cleanly.schmoppo.de",
		"androidScheme": "https"
	},
	"webDir": "dist",
	"plugins": {
		"Keyboard": {
			"resizeOnFullScreen": true
		},
		"StatusBar": {
			"overlaysWebView": false
		},
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		},
		"SystemBars": {
			"insetsHandling": "css"
		}
	}
}
