{
	"appId": "de.schmoppo.cleanly",
	"appName": "cleanly",
	"server": {
		"hostname": "deeplink.cleanly.schmoppo.de",
		"cleartext": true,
		"androidScheme": "http"
	},
	"webDir": "dist",
	"plugins": {
		"Keyboard": {
			"resizeOnFullScreen": true
		},
		"StatusBar": {
			"overlaysWebView": false
		},
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		}
	},
	"android": {
		"adjustMarginsForEdgeToEdge": "force"
	}
}
