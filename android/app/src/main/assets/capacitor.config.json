{
	"appId": "io.ionic.starter",
	"appName": "cleanly",
	"webDir": "dist",
	"bundledWebRuntime": false,
	"plugins": {
		"Keyboard": {
			"resizeOnFullScreen": true
		},
		"StatusBar": {
			"overlaysWebView": false
		},
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		}
	},
	"android": {
		"adjustMarginsForEdgeToEdge": "force"
	}
}
