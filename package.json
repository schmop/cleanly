{
  "name": "cleanly",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "test:unit": "vue-cli-service test:unit",
    "test:e2e": "vue-cli-service test:e2e",
    "build:android": "capacitor update android && vue-cli-service build --mode=development && rmdir /s /Q \"android/app/src/main/assets/public\" && Xcopy /E /I \"dist\" \"android/app/src/main/assets/public\"",
    "lint": "vue-cli-service lint",
    "postinstall": "patch-package"
  },
